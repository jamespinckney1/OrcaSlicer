+# ---- Print-shop quick start (QUICK=1 FLUSH=0|1 from the slicer) ------------------------------
+# The slicer remembers which filament the last print it sent started with and passes FLUSH=0 when
+# this print starts with the same filament, FLUSH=1 when it changed or is unknown.
+#
+# QUICK_MESH: QIDI's own G29 "leveling off" path (home, measure nozzle height, load the full-bed
+# "default" mesh) without the Z_VIBRATE bed shake. Never loads the part-scoped "kamp" mesh, which
+# only covers the previous part's footprint. Only trusts a "default" mesh built by SHOP_FULL_MESH
+# (captured after Z_TILT_ADJUST, like a normal start); otherwise runs full leveling.
+[gcode_macro QUICK_MESH]
+gcode:
+    {% set trusted = printer.save_variables.variables.shop_full_mesh_ok|default(0)|int == 1 %}
+    {% if trusted and 'default' in printer.bed_mesh.profiles %}
+        {% set temp = printer["heater_generic chamber"].target %}
+        M141 S0
+        {% if temp > 0 %}
+            G4 P15000
+        {% endif %}
+        BED_MESH_CLEAR
+        G28
+        QUICK_ZOFFSET
+        M141 S{temp}
+        BED_MESH_PROFILE LOAD=default
+        SAVE_VARIABLE VARIABLE=profile_name VALUE='"default"'
+        M118 Quick start: loaded full-bed mesh default
+    {% else %}
+        M118 Quick start: no full-bed mesh from SHOP_FULL_MESH yet, running full leveling
+        G29
+    {% endif %}
+
+# get_zoffset without the Z_VIBRATE bed shake. Still measures the nozzle height (5 slow touches),
+# which sets the first layer height.
+[gcode_macro QUICK_ZOFFSET]
+gcode:
+    TOGGLE_CHAMBER_FAN
+    G1 Z10 F600
+    QIDI_PROBE_PIN_1
+    m204 S50
+    G4 P500
+    probe probe_speed=5 lift_speed=5 samples=5 sample_retract_dist=5
+    move_subzoffset
+    M114
+    {% set p=(-0.11 + printer.gcode_move.homing_origin.z)|float %}
+    SET_KINEMATIC_POSITION Z={p}
+    G1 Z30 F600
+    QIDI_PROBE_PIN_2
+    m204 S10000
+    TOGGLE_CHAMBER_FAN
+
+# Rebuilds the full-bed "default" mesh that quick start loads (81 points, several minutes).
+# Same order as a normal start (home, Z_TILT_ADJUST, home, nozzle height, mesh), so the mesh is
+# consistent with the gantry levelling quick start runs first. Run it after a plate change or
+# every few weeks:   SHOP_FULL_MESH BED=80
+[gcode_macro SHOP_FULL_MESH]
+description: Rebuild the full-bed default mesh used by quick start
+gcode:
+    {% set bed = params.BED|default(80)|int %}
+    M118 Rebuilding full-bed mesh at bed {bed} C
+    M190 S{bed}
+    BED_MESH_CLEAR
+    G28
+    Z_TILT_ADJUST
+    G28
+    get_zoffset
+    G1 X{150 - printer.probe["x_offset"]} Y{150 - printer.probe["y_offset"]} F9000
+    G1 Z10 F600
+    probe
+    SAVE_Z_OFFSET_TO_BED_MESH
+    G1 Z10 F600
+    _BED_MESH_CALIBRATE PROFILE=default
+    SAVE_VARIABLE VARIABLE=shop_full_mesh_ok VALUE=1
+    G4 P5000
+    SAVE_CONFIG_QD
+    M140 S0
+    M118 Full-bed mesh saved as default
